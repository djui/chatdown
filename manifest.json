{
  "manifest_version": 3,
  "name": "Chatdown",
  "version": "0.1.0",
  "description": "Export ChatGPT, Codex and Claude conversations to Markdown. Pick which requests and responses to include.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Export chat to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "permissions": ["sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/html2md.js",
        "src/content/parsers.js",
        "src/content/extractors.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
